{
  "format": "rulith-worker-tools/1",
  "tools": {
    "eng.list@1": {
      "adapter": "run",
      "kind": "read",
      "params": {
        "path": "string"
      },
      "returns": [
        {
          "predicate": "eng.file",
          "args": {
            "path": "$path",
            "kind": "$kind"
          }
        },
        {
          "predicate": "eng.tree_step",
          "args": {
            "from_gen": "$from_gen",
            "to_gen": "$to_gen"
          }
        }
      ],
      "sourceTypes": [
        "file"
      ],
      "entry": "adapters/engineering-work/list.mjs",
      "env": {
        "pass": [
          "ENG_KIT_HOME"
        ]
      }
    },
    "eng.read@1": {
      "adapter": "run",
      "kind": "read",
      "params": {
        "path": "string",
        "offset": "number?"
      },
      "returns": [
        {
          "predicate": "eng.file_read",
          "args": {
            "path": "$path",
            "digest": "$digest",
            "bytes": "$bytes",
            "offset": "$offset",
            "tail_offset": "$tail_offset"
          }
        },
        {
          "predicate": "eng.tree_step",
          "args": {
            "from_gen": "$from_gen",
            "to_gen": "$to_gen"
          }
        }
      ],
      "sourceTypes": [
